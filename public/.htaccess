# Forçar MIME type correto para arquivos importantes
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType application/xml .xml
</IfModule>

# Roteamento para aplicação React SPA
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Arquivos especiais - servir diretamente sem redirect
  RewriteRule ^ads\.txt$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^humans\.txt$ - [L]
  RewriteRule ^security\.txt$ - [L]
  RewriteRule ^llms\.txt$ - [L]
  RewriteRule ^\.well-known/.*$ - [L]

  # Forçar HTTPS (http -> https)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Forçar non-www (www.gruposdewhats.com.br -> gruposdewhats.com.br)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
  
  # ============================================================
  # 301 — Limpa querystrings de tracking/compartilhamento antigos
  # ============================================================
  RewriteCond %{QUERY_STRING} (^|&)(share|nb|enviar|grupo|fbclid|gclid|utm_[a-z]+)= [NC]
  RewriteRule ^(.*)$ /$1? [R=301,L]

  # ============================================================
  # 301 — URLs administrativas/legadas do WordPress
  # ============================================================
  RewriteRule ^wp-login\.php /auth [R=301,L]
  RewriteRule ^wp-admin(/.*)?$ /auth [R=301,L]
  RewriteRule ^author/.*$ / [R=301,L]
  RewriteRule ^page/[0-9]+/?$ / [R=301,L]
  RewriteRule ^blog/page/[0-9]+/?$ /blog [R=301,L]
  RewriteRule ^.+/feed/?$ / [R=301,L]
  RewriteRule ^category/sem-categoria/?$ / [R=301,L]
  RewriteRule ^category/(.*)$ / [R=301,L]
  RewriteRule ^produto/(.*)$ / [R=301,L]
  RewriteRule ^servico/(.*)$ / [R=301,L]

  # ============================================================
  # 301 — Páginas institucionais antigas → novas rotas
  # ============================================================
  RewriteRule ^quem-somos/?$ /sobre [R=301,L]
  RewriteRule ^categorias/?$ /todos-grupos [R=301,L]
  RewriteRule ^cadastro/?$ /auth [R=301,L]
  RewriteRule ^entrar/?$ /auth [R=301,L]
  RewriteRule ^minha-conta(/.*)?$ /auth [R=301,L]
  RewriteRule ^privacy-policy/?$ /politica-de-privacidade [R=301,L]
  RewriteRule ^cookie-policy/?$ /politica-de-cookies [R=301,L]
  RewriteRule ^terms-of-service/?$ /termos-de-uso [R=301,L]
  RewriteRule ^all-groups/?$ /todos-grupos [R=301,L]
  RewriteRule ^politica-de-dmca/?$ /termos-de-uso [R=301,L]

  # ============================================================
  # 301 — Slugs antigos de posts do blog → novos slugs
  # ============================================================
  RewriteRule ^blog/regras-essenciais/?$ /blog/regras-essenciais-grupo-organizado [R=301,L]
  RewriteRule ^blog/grupos-premium/?$ /blog/por-que-grupos-premium-tem-mais-sucesso [R=301,L]
  RewriteRule ^blog/aumentar-engajamento/?$ /blog/como-aumentar-engajamento-grupo [R=301,L]
  RewriteRule ^blog/melhores-horarios/?$ /blog/melhores-horarios-postar-grupos [R=301,L]
  RewriteRule ^blog/seguranca-whatsapp/?$ /blog/seguranca-whatsapp-proteja-seu-grupo [R=301,L]
  RewriteRule ^blog/grupo-sucesso-2025/?$ /blog/como-criar-grupo-sucesso-2026 [R=301,L]
  RewriteRule ^blog/como-criar-grupo-sucesso-2025/?$ /blog/como-criar-grupo-sucesso-2026 [R=301,L]

  # ============================================================
  # 301 — Remove trailing slash de URLs (exceto raiz e diretórios reais)
  # Evita conteúdo duplicado entre /faq e /faq/
  # ============================================================
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # ============================================================
  # 301 — Slugs órfãos no root (URLs antigas do WordPress que não existem mais)
  # Qualquer caminho de um único segmento que NÃO corresponda a rotas conhecidas → home
  # ============================================================
  RewriteCond %{REQUEST_URI} !^/(auth|admin|admin-setup|admin-users|dashboard|blog|faq|contato|sobre|quem-somos|como-funciona|central-ajuda|dicas-seguranca|seguranca-transparencia|regras-comunidade|reportar-problema|termos-de-uso|politica-de-privacidade|politica-de-cookies|politica-transparencia|todos-grupos|all-groups|categoria|category|grupo|artigo|sitemap|migrate-images|assets|images|api|favicon|index\.html|placeholder|robots\.txt|sitemap\.xml|ads\.txt|humans\.txt|llms\.txt|security\.txt|\.well-known)(/|$)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^[^/]+$ / [R=301,L]

  # ============================================================
  # SPA fallback — se não for arquivo nem diretório, serve index.html
  # ============================================================
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Compressão Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Headers de Segurança e Cache
<IfModule mod_headers.c>
  # Previne ataques MIME-type
  Header set X-Content-Type-Options "nosniff"
  
  # Previne clickjacking
  Header set X-Frame-Options "SAMEORIGIN"
  
  # Habilita proteção XSS do navegador
  Header set X-XSS-Protection "1; mode=block"
  
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Permissions Policy
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  
  # HSTS — força HTTPS por 1 ano (reduz alertas de "site não seguro")
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # Content-Security-Policy — sinaliza para antivírus que o site controla suas fontes
  Header set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://*.supabase.co https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co https://www.google-analytics.com https://*.googletagmanager.com wss://*.supabase.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  
  # Cross-Origin policies
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header set Cross-Origin-Resource-Policy "same-site"
  
  # Cache control para HTML - sempre revalidar
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  
  # Cache control para assets com hash (Vite) - cache longo
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Cache de recursos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Imagens
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS e JavaScript com hash (gerados pelo Vite)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # Fontes
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/eot "access plus 1 year"
  
  # HTML
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
